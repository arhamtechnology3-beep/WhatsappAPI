# Paste into Hostinger hPanel → Node.js app → Environment variables
# AFTER the VPS Supabase stack is up and data is restored.
# Do NOT commit real keys.

# Was: https://xxxx.supabase.co  → now your VPS HTTPS API URL
NEXT_PUBLIC_SUPABASE_URL=https://db.arhamtechnology.com

# From VPS Studio / .env (anon / service_role)
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-vps-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-vps-service-role-key

# Unchanged (same values as today on Hostinger Node)
# ENCRYPTION_KEY=
# AUTOMATION_CRON_SECRET=
# CRON_SECRET=
# Meta / Shopify / Shiprocket secrets stay as-is
